# BusCommand — server env (kopiraj u .env ili postavi na hostingu)
# NIKAD ne commituj .env sa tajnim vrednostima.

PORT=8766
LOG_LEVEL=info

# Produkcija: dozvoljeni browser origin-i (zarezom, bez razmaka oko URL-a)
CORS_ORIGINS=https://buscommand.com,https://www.buscommand.com

# Firebase Admin SDK — fajl firebase-admin-key.json u root-u repozitorijuma
# (ne ide u git; vidi .gitignore)
