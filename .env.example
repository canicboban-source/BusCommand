# BusCommand — server env (kopiraj u .env ili postavi na hostingu)
# NIKAD ne commituj .env sa tajnim vrednostima.

PORT=8766
LOG_LEVEL=info

# Produkcija: dozvoljeni browser origin-i (zarezom, bez razmaka oko URL-a)
CORS_ORIGINS=https://buscommand.com,https://www.buscommand.com,https://buscommand-preview.onrender.com

# Render secret: puni Firebase service-account JSON u jednoj varijabli.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Javna Firebase browser konfiguracija za Vite build (nije Admin SDK tajna).
VITE_FIREBASE_API_KEY=AIzaSyCr9Q8b36nRRX_JIEmYgbLGaS7LEG1LRIo
VITE_FIREBASE_AUTH_DOMAIN=buscommand-preview.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=buscommand-preview
VITE_FIREBASE_STORAGE_BUCKET=buscommand-preview.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=475316242257
VITE_FIREBASE_APP_ID=1:475316242257:web:5782bb509578f28ac6b570

# Firebase Admin SDK — NEVER place a key file in the project tree.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON (platform secret) or
# GOOGLE_APPLICATION_CREDENTIALS pointing outside the repo.
# If a local JSON key was ever present here, revoke/rotate it in Google Cloud.

# Shared secret for POST /api/internal/jobs/confirmation-dispatch (Render cron).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value on web + cron services in Render dashboard.
CONFIRMATION_JOB_SECRET=
