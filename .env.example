# BusCommand — server env (kopiraj u .env ili postavi na hostingu)
# NIKAD ne commituj .env sa tajnim vrednostima.

PORT=8766
LOG_LEVEL=info

# Runtime isolation: development | staging | production
# staging → Firebase project buscommand-preview (TEST-ONLY), exact CORS only
BUSCOMMAND_ENV=development

# Exact browser origins (comma-separated). No wildcards. No suffix matching.
# Staging: set in Render dashboard (sync:false) to the REAL assigned staging origin
# after service `buscommand-preview-staging` is created. Do NOT assume an onrender.com URL.
# Production: set only in the production dashboard (never in render.staging.yaml).
CORS_ORIGINS=

# Render secret: puni Firebase service-account JSON u jednoj varijabli.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Javna Firebase browser konfiguracija za Vite build (nije Admin SDK tajna).
VITE_FIREBASE_API_KEY=AIzaSyCr9Q8b36nRRX_JIEmYgbLGaS7LEG1LRIo
VITE_FIREBASE_AUTH_DOMAIN=buscommand-preview.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=buscommand-preview
VITE_FIREBASE_STORAGE_BUCKET=buscommand-preview.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=475316242257
VITE_FIREBASE_APP_ID=1:475316242257:web:5782bb509578f28ac6b570

# Firebase Admin SDK — NEVER place a key file in the project tree.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON (platform secret) or
# GOOGLE_APPLICATION_CREDENTIALS pointing outside the repo.
# If a local JSON key was ever present here, revoke/rotate it in Google Cloud.

# Shared secret for POST /api/internal/jobs/confirmation-dispatch (Render cron).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value on web + cron services in Render dashboard.
CONFIRMATION_JOB_SECRET=

# Required for cron script — no hardcoded host fallback.
# Staging: omit cron service entirely (see render.staging.yaml).
# Production host only — never set a production URL under BUSCOMMAND_ENV=staging.
CONFIRMATION_DISPATCH_URL=

# SMS (driver activation OTP). Modes: stub | none | twilio | seven
# Local default without this var: stub (dev) / none (production NODE_ENV).
# Keys NEVER go in git — only .env / host secrets.
SMS_PROVIDER=
# seven.io (preferred for EU pilot when Twilio KYC is pending)
SEVEN_API_KEY=
# Use short GSM sender; unregistered brands (e.g. BusCommand) are often REJECTED in AT.
SEVEN_FROM=SMS
# Twilio (optional / backup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Force stub SMS (Playwright / QA harness set this automatically — never send live SMS in tests)
# BUSCOMMAND_FORCE_SMS_STUB=1
# BUSCOMMAND_QA_HARNESS=1
# Public origin for SMS/portal links — exact HTTPS origin, no path/query/hash.
# Staging: same value as CORS_ORIGINS (dashboard sync:false on buscommand-preview-staging).
# Production: production origin only in the production dashboard.
# No cross-environment fallback.
APP_PUBLIC_URL=
