rules_version = '2';

// ============================================================
// BusCommand — Firestore Security Rules
// KRITIČNO: multi-tenant izolacija + Dispo group scope (FAZA 1)
// knownGroupIds NEVER grants document read (D18 = CA metadata only)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── SUPERADMIN ─────────────────────────────────────────
    // SuperAdmin nadzire sve firme, ali samo čita.
    // Rules su aditivne: da je ovdje dozvoljen `write`, SuperAdmin browser
    // sesija bi nadjačala `allow write: if false` na audit_log-u i ostalim
    // server-owned kolekcijama. Sve promjene idu kroz Admin SDK API koji
    // validira tenant, poslovna pravila i piše audit zapis.

    match /companies/{companyId}/{companyCollection}/{document=**} {
      // D24.1.1: SuperAdmin browser may not read credential-bearing driver profiles.
      // D24.2: SuperAdmin browser may not read server-only ops (driver_identity_guard).
      allow read: if isSuperAdmin()
                  && companyCollection != "driver_credentials"
                  && companyCollection != "ops"
                  && (companyCollection != "drivers" || !driverProfileExposesCredentials());
      allow write: if false;
    }

    // ─── FIRMA — SOPSTVENI PODACI ───────────────────────────

    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isCompanyMember(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/profile/{doc} {
      allow read: if isCompanyMember(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/branding/{doc} {
      allow read: if isCompanyMember(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/settings/{doc} {
      // settings/sos carries live SOS identity — Dispo only if driver's home group assigned
      allow read: if isCompanyMember(companyId)
                  && (doc != "sos"
                      || isCompanyAdmin(companyId)
                      || canDispatcherReadSosSettings(companyId)
                      || (isDriver(companyId)
                          && resource.data.get("sosDriverId", "") == request.auth.uid));
      allow write: if false;
    }

    match /companies/{companyId}/users/{userId} {
      allow read: if isCompanyAdmin(companyId)
                  || (isCompanyMember(companyId) && request.auth.uid == userId);
      allow create, delete: if false;
      allow update: if isCompanyMember(companyId) && request.auth.uid == userId
                    && onlyUpdatingOwnProfile();
    }

    // ─── VOZAČI ─────────────────────────────────────────────
    // knownGroupIds must NOT grant read (FAZA 1 / req 5). Home groupId only.

    match /companies/{companyId}/drivers/{driverId} {
      // D24.1.1: credential-bearing profiles are CA-only (migration). Dispo, own driver,
      // and SuperAdmin browser sessions are denied until the profile is clean.
      allow read: if isCompanyAdmin(companyId)
                  || (
                    !driverProfileExposesCredentials()
                    && (
                      canDispatcherReadHomeGroup(
                        companyId,
                        resource.data.get("groupId", resource.data.get("lineId", ""))
                      )
                      || isOwnDriverProfile(companyId, driverId)
                    )
                  );
      allow create, delete: if false;
      allow update: if isDriver(companyId) && request.auth.uid == driverId
                    && onlyUpdatingAllowedDriverFields()
                    && isDriverLocationWriteAllowed(companyId);
    }

    // ─── SMJENE ─────────────────────────────────────────────

    match /companies/{companyId}/shifts/{shiftId} {
      allow read: if isCompanyAdmin(companyId)
                  || canDispatcherReadHomeGroup(companyId, resource.data.get("groupId", resource.data.get("lineId", "")))
                  || (isDriver(companyId) && resource.data.driverId == request.auth.uid
                      && isDriverNotificationWindow(companyId));
      allow create, update, delete: if false;
    }

    // ─── PORUKE ─────────────────────────────────────────────

    match /companies/{companyId}/messages/{msgId} {
      allow read: if isCompanyAdmin(companyId)
                  || (isDispatcher(companyId)
                      && resource.data.keys().hasAny(["groupId"])
                      && resource.data.groupId is string
                      && isDispatcherAssignedGroup(companyId, resource.data.groupId));
      allow read: if isDriverNotificationWindow(companyId)
                  && (resource.data.broadcast == true
                      || resource.data.recipientDriverId == request.auth.uid);
      allow create: if false;
      allow update: if canDriverReadMessage(companyId) && onlyMarkingRead();
      allow delete: if false;
    }

    // ─── SOS ALARMI ─────────────────────────────────────────

    match /companies/{companyId}/sos/{sosId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || canDispatcherReadHomeGroup(companyId, resource.data.get("groupId", ""))
                      || (isDriver(companyId) && resource.data.driverId == request.auth.uid));
      allow create, update, delete: if false;
    }

    // ─── RASPORED ───────────────────────────────────────────

    match /companies/{companyId}/schedules/{scheduleId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || canDispatcherReadHomeGroup(companyId, resource.data.get("groupId", resource.data.get("lineId", "")))
                      || (isDriver(companyId) && resource.data.driverId == request.auth.uid
                          && isDriverNotificationWindow(companyId)));
      allow write: if false;
    }

    match /companies/{companyId}/service_plans/{planId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || canDispatcherReadHomeGroup(companyId, resource.data.get("groupId", "")));
      allow write: if false;
    }

    match /companies/{companyId}/service_plans/{planId}/duties/{dutyId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || (isDispatcher(companyId)
                          && exists(/databases/$(database)/documents/companies/$(companyId)/service_plans/$(planId))
                          && isDispatcherAssignedGroup(
                                companyId,
                                get(/databases/$(database)/documents/companies/$(companyId)/service_plans/$(planId)).data.get("groupId", "")
                             )));
      allow write: if false;
    }

    match /companies/{companyId}/driver_sessions/{driverId} {
      allow read: if isCompanyAdmin(companyId)
                  || canDispatcherAccessDriver(companyId, driverId)
                  || (isDriver(companyId) && request.auth.uid == driverId);
      allow write: if false;
    }

    match /companies/{companyId}/shift_confirmations/{confirmationId} {
      allow read: if isCompanyAdmin(companyId)
                  || (isDispatcher(companyId)
                      && resource.data.keys().hasAny(["driverId"])
                      && canDispatcherAccessDriver(companyId, resource.data.driverId));
      allow write: if false;
    }

    match /companies/{companyId}/confirmation_outbox/{outboxId} {
      allow read: if isCompanyAdmin(companyId)
                  || (isDispatcher(companyId)
                      && resource.data.keys().hasAny(["driverId"])
                      && canDispatcherAccessDriver(companyId, resource.data.driverId))
                  || (isDriver(companyId) && resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    match /companies/{companyId}/groups/{groupId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || (isDispatcher(companyId) && isDispatcherAssignedGroup(companyId, groupId))
                      || (isDriver(companyId) && driverHomeGroupEquals(companyId, groupId)));
      allow write: if false;
    }

    match /companies/{companyId}/buses/{busId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || canDispatcherReadBus(companyId)
                      || (isDriver(companyId) && driverCanReadBus(companyId)));
      allow write: if false;
    }

    match /companies/{companyId}/routes/{routeId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || canDispatcherReadHomeGroup(companyId, resource.data.get("groupId", resource.data.get("lineId", "")))
                      || (isDriver(companyId) && driverHomeGroupEquals(companyId, resource.data.get("groupId", resource.data.get("lineId", "")))));
      allow write: if false;
    }

    match /companies/{companyId}/reports/{reportId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || (isDispatcher(companyId) && isDispatcherAssignedGroup(companyId, resource.data.groupId))
                      || (isDriver(companyId) && resource.data.driverId == request.auth.uid));
      allow create, update, delete: if false;
    }

    match /companies/{companyId}/vacations/{vacId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || canDispatcherReadHomeGroup(companyId, resource.data.get("groupId", ""))
                      || (isDriver(companyId) && resource.data.driverId == request.auth.uid));
      allow create, update, delete: if false;
    }

    match /companies/{companyId}/lost_items/{itemId} {
      allow read: if isLicenseActive(companyId)
                  && (isCompanyAdmin(companyId)
                      || canDispatcherReadHomeGroup(companyId, resource.data.get("groupId", ""))
                      || (isDriver(companyId) && resource.data.driverId == request.auth.uid));
      allow write: if false;
    }

    match /companies/{companyId}/company_admins/{adminId} {
      allow read: if isCompanyAdmin(companyId);
      allow write: if false;
    }

    // ─── AUDIT LOG (GDPR — nepromjenjivo) ───────────────────

    match /companies/{companyId}/audit_log/{logId} {
      allow read: if isCompanyAdmin(companyId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── SUPPORT SESSIONS (L7 — Admin SDK only) ─────────────

    match /companies/{companyId}/support_sessions/{sessionId} {
      allow read: if isCompanyAdmin(companyId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ─── INTERNA KOORDINACIJA (samo Admin SDK) ──────────────

    match /companies/{companyId}/monthly_plan_imports/{importId} {
      allow read, write: if false;
    }

    match /companies/{companyId}/monthly_plan_import_locks/{lockId} {
      allow read, write: if false;
    }

    match /companies/{companyId}/plan_locks/{lockId} {
      allow read, write: if false;
    }

    // Server-only ops docs (Admin SDK). Includes D24.2 driver_identity_guard
    // (companies/{companyId}/ops/driver_identity_guard) — browser R/W/L deny.
    match /companies/{companyId}/ops/{opsId} {
      allow read, write: if false;
    }

    // ─── HELPER FUNCTIONS ───────────────────────────────────

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.mustChangeLoginCode != true
        && request.auth.token.role == "superadmin";
    }

    function isCompanyMember(companyId) {
      return request.auth != null
        && request.auth.token.companyId == companyId
        && request.auth.token.mustChangeLoginCode != true
        && ((request.auth.token.role == "driver"
             && get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(request.auth.uid)).data.get("active", true) != false)
            || ((request.auth.token.role == "dispatcher" || request.auth.token.role == "company_admin")
                && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.get("active", true) != false
                && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.get("sessionsValidAfterEpoch", 0) < request.auth.token.auth_time));
    }

    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId)
        && request.auth.token.role == "company_admin";
    }

    function isCompanyStaff(companyId) {
      return isCompanyMember(companyId)
        && (request.auth.token.role == "dispatcher"
            || request.auth.token.role == "company_admin");
    }

    function isDriver(companyId) {
      return isCompanyMember(companyId)
        && request.auth.token.role == "driver";
    }

    function isOwnDriverProfile(companyId, driverId) {
      return isDriver(companyId)
        && request.auth.uid == driverId;
    }

    function isDispatcher(companyId) {
      return isCompanyMember(companyId)
        && request.auth.token.role == "dispatcher";
    }

    function isDispatcherAssignedGroup(companyId, groupId) {
      return groupId is string
        && groupId.size() > 0
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.groups.hasAny([groupId]);
    }

    function canDispatcherReadHomeGroup(companyId, groupId) {
      return isDispatcher(companyId) && isDispatcherAssignedGroup(companyId, groupId);
    }

    // Fail-closed for legacy/miswritten profiles that still embed credentials (D24.1.1).
    // Key ownership (including null values) — keep in sync with CREDENTIAL_FIELDS.
    function driverProfileExposesCredentials() {
      return resource.data.keys().hasAny([
        "eid",
        "companyCodeHash",
        "loginCodeHash",
        "temporaryCodeHash",
        "temporaryHash",
        "company_code",
        "companyCode",
        "pin",
        "password",
        "passwordHash"
      ]);
    }

    function driverDoc(companyId, driverId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(driverId));
    }

    function driverHomeGroupId(companyId, driverId) {
      return driverDoc(companyId, driverId).data.get(
        "groupId",
        driverDoc(companyId, driverId).data.get("lineId", "")
      );
    }

    function canDispatcherAccessDriver(companyId, driverId) {
      return isDispatcher(companyId)
        && exists(/databases/$(database)/documents/companies/$(companyId)/drivers/$(driverId))
        && isDispatcherAssignedGroup(companyId, driverHomeGroupId(companyId, driverId));
    }

    function driverHomeGroupEquals(companyId, groupId) {
      return groupId is string
        && groupId.size() > 0
        && driverHomeGroupId(companyId, request.auth.uid) == groupId;
    }

    function dispatcherAssignedGroups(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.groups;
    }

    function canDispatcherReadBus(companyId) {
      return isDispatcher(companyId)
        && (
          isDispatcherAssignedGroup(companyId, resource.data.get("groupId", ""))
          || (resource.data.keys().hasAny(["groupIds"])
              && resource.data.groupIds is list
              && dispatcherAssignedGroups(companyId).hasAny(resource.data.groupIds))
        );
    }

    function driverCanReadBus(companyId) {
      return isDriver(companyId)
        && (
          driverHomeGroupEquals(companyId, resource.data.get("groupId", ""))
          || (resource.data.keys().hasAny(["groupIds"])
              && resource.data.groupIds is list
              && resource.data.groupIds.hasAny([driverHomeGroupId(companyId, request.auth.uid)]))
        );
    }

    function canDispatcherReadSosSettings(companyId) {
      return isDispatcher(companyId)
        && (
          resource.data.get("sosActive", false) != true
          || (
            resource.data.get("sosDriverId", "") is string
            && resource.data.get("sosDriverId", "").size() > 0
            && canDispatcherAccessDriver(companyId, resource.data.sosDriverId)
          )
        );
    }

    function isDriverNotificationWindow(companyId) {
      return isDriver(companyId)
        && exists(/databases/$(database)/documents/companies/$(companyId)/driver_sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(companyId)/driver_sessions/$(request.auth.uid)).data.notificationsUntil >= request.time;
    }

    // Server-only driver authentication material. Firebase Admin SDK bypasses Rules.
    match /companies/{companyId}/driver_credentials/{driverId} {
      allow read, write: if false;
    }

    function canDriverReadMessage(companyId) {
      return isDriver(companyId)
        && (resource.data.broadcast == true
            || resource.data.recipientDriverId == request.auth.uid);
    }

    function isLicenseActive(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/settings/main).data.status != "suspended";
    }

    function isDriverLocationWriteAllowed(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)/driver_sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(companyId)/driver_sessions/$(request.auth.uid)).data.sessionEndsAt >= request.time;
    }

    function onlyUpdatingAllowedDriverFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["lastSeen", "lastLocation"]);
    }

    function onlyUpdatingOwnProfile() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["name", "language"]);
    }

    function onlyMarkingRead() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["read", "readAt"]);
    }
  }
}
